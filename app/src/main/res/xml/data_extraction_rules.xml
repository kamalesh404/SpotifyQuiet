<?xml version="1.0" encoding="utf-8"?>
<!--
    SpotifyQuiet stores nothing that needs to leave the device: no cloud
    backup and no device-to-device transfer of app data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
